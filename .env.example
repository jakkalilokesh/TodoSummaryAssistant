# Database connection
DB_URL=jdbc:mysql://localhost:3307/todo_db
DB_USERNAME=your_db_username
DB_PASSWORD=replace_with_your_db_password

# External integrations
COHERE_API_KEY=replace_with_your_cohere_api_key
SLACK_WEBHOOK_URL=

# Frontend origin allowed by the backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional local Grafana credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_before_use
