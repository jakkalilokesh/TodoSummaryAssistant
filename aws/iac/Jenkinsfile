
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        TF_IN_AUTOMATION = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('aws/iac') {
                    sh 'terraform init'
                }
            }
        }

        stage('Validate') {
            steps {
                dir('aws/iac') {
                    sh 'terraform fmt -check'
                    sh 'terraform validate'
                }
            }
        }

        stage('Plan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'todo-db-password',
                        variable: 'TF_VAR_db_password'
                    )
                ]) {
                    dir('aws/iac') {
                        sh 'terraform plan -out=tfplan'
                    }
                }
            }
        }

        stage('Approval') {
            steps {
                input message: 'Review the Terraform plan and approve these AWS changes?'
            }
        }

        stage('Apply') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'todo-db-password',
                        variable: 'TF_VAR_db_password'
                    )
                ]) {
                    dir('aws/iac') {
                        sh 'terraform apply -auto-approve tfplan'
                    }
                }
            }
        }
    }

    post {
        always {
            dir('aws/iac') {
                sh 'rm -f tfplan'
            }
        }

        success {
            echo 'Infrastructure deployment completed.'
        }

        failure {
            echo 'Infrastructure pipeline failed. Check the console log.'
        }
    }
}
